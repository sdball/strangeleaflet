#!/usr/bin/env python3
"""Stamp published_date on posts and leaflet pages that this commit publishes.

Drafts (publish: false) leave published_date out. When a commit includes a
post that will be published and still has no published_date, this sets it to
the current time and stages that change, so the date is when it went out.
"""

import re
import subprocess
import sys
from datetime import datetime, timezone

# Posts and leaflet pages, which go in the feed. Leaflet covers have no date.
POST = re.compile(r"^(posts/([^/]+\.(md|html)|[^/]+/index\.(md|html))"
                  r"|leaflets/[^/]+/page-\d+(\.(md|html)|/index\.(md|html)))$")


def git(*args, check=True):
    return subprocess.run(["git", *args], check=check, capture_output=True, text=True)


def frontmatter(text):
    if not text.startswith("---\n"):
        return None
    end = text.find("\n---\n", 4)
    return text[4:end] if end != -1 else None


def needs_date(head):
    if re.search(r"^publish:\s*false\s*$", head, re.M):
        return False
    return not re.search(r"^published_date:\s*\S", head, re.M)


def stamp(text, now):
    head = frontmatter(text)
    lines = head.split("\n")
    line = f"published_date: {now}"
    for i, current in enumerate(lines):
        if current.startswith("published_date:"):
            lines[i] = line
            break
    else:
        after = next((i for i, l in enumerate(lines) if l.startswith("slug:")), None)
        if after is None:
            after = next((i for i, l in enumerate(lines) if l.startswith("title:")), -1)
        lines.insert(after + 1, line)
    return "---\n" + "\n".join(lines) + text[4 + len(head):]


now = datetime.now(timezone.utc).replace(microsecond=0).isoformat()
staged = git("diff", "--cached", "--name-only", "--diff-filter=ACMR").stdout.split("\n")

for path in filter(POST.match, staged):
    head = frontmatter(git("show", f":{path}").stdout)
    if head is None or not needs_date(head):
        continue
    if git("diff", "--quiet", "--", path, check=False).returncode != 0:
        sys.exit(f"{path} is being published but has unstaged changes. "
                 "Stage or stash them so its published_date can be added.")
    with open(path) as f:
        text = f.read()
    with open(path, "w") as f:
        f.write(stamp(text, now))
    git("add", path)
    print(f"Stamped {path} with published_date: {now}")
