#!/bin/sh
# Build, then serve public/ locally, the way GitHub Pages will.
# Usage: scripts/serve [port]   (default 8000, or $PORT)

set -e

root="$(cd "$(dirname "$0")/.." && pwd)"
port="${1:-${PORT:-8000}}"

"$root/scripts/build"

echo "Serving $root/public at http://localhost:$port/ (Ctrl-C to stop)"
cd "$root/public"
exec "$root/.venv/bin/python" -c '
import sys
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer

class Handler(SimpleHTTPRequestHandler):
    index_pages = ("index.html", "index.xml")  # /feed/ is feed/index.xml

    def send_error(self, code, message=None, explain=None):
        if code == 404:  # GitHub Pages serves 404.html
            try:
                body = open("404.html", "rb").read()
            except OSError:
                return super().send_error(code, message, explain)
            self.send_response(404)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        super().send_error(code, message, explain)

ThreadingHTTPServer(("127.0.0.1", int(sys.argv[1])), Handler).serve_forever()
' "$port"
