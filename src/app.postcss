/* Write your global styles here, in PostCSS syntax */

@import "katex/dist/katex.min.css";

@tailwind base;

@tailwind components;

.all-prose {
  @apply prose prose-lg lg:prose-xl;
}

@tailwind utilities;

:where(h1) {
  .icon-link {
    position: relative;

    &::before {
      content: "#";
      position: absolute;
      left: -1.5ch;
      top: 0;
      line-height: 1;
      opacity: 0;
      text-decoration: underline;
    }
  }

  &:hover .icon-link::before {
    opacity: 1;
  }
}

:where(h2) {
  .icon-link {
    position: relative;

    &::before {
      content: "##";
      position: absolute;
      left: -2.5ch;
      top: 0;
      line-height: 1;
      opacity: 0;
      text-decoration: underline;
    }
  }

  &:hover .icon-link::before {
    opacity: 1;
  }
}

:where(h3, h4, h5, h6) {
  .icon-link {
    position: relative;

    &::before {
      content: "###";
      position: absolute;
      left: -3.5ch;
      top: 0;
      line-height: 1;
      opacity: 0;
      text-decoration: underline;
    }
  }

  &:hover .icon-link::before {
    opacity: 1;
  }
}
